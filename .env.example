# Database Configuration for Neon PostgreSQL
# Get these values from your Neon dashboard: https://console.neon.tech

# Pooled connection string (recommended for serverless)
# Format: postgresql://user:password@ep-xxx-xxx-pooler.region.aws.neon.tech/database?sslmode=require
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-1.aws.neon.tech/portfolio?sslmode=require"

# Direct connection string (for migrations)
# Format: postgresql://user:password@ep-xxx-xxx.region.aws.neon.tech/database?sslmode=require
DIRECT_DATABASE_URL="postgresql://user:password@ep-example.us-east-1.aws.neon.tech/portfolio?sslmode=require"

# Genkit AI Configuration (optional - for AI features)
# GOOGLE_GENAI_API_KEY="your-google-ai-api-key"
# OPENAI_API_KEY="your-openai-api-key"
